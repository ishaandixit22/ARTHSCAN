// Arthscan website Worker (SvelteKit). Owns arthscan.me; the API Worker's path
// routes (/api, /v1, /mcp, /oauth, /.well-known) run in front of it.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "arthscan-web",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-01",
  // SvelteKit's getRequestEvent needs AsyncLocalStorage.
  "compatibility_flags": ["nodejs_als"],
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  "workers_dev": false,
  "routes": [
    { "pattern": "arthscan.me", "custom_domain": true },
    { "pattern": "www.arthscan.me", "custom_domain": true }
  ],
  // Page loads reach the API Worker directly, not over the public internet.
  "services": [{ "binding": "API", "service": "arthscan-api" }],
  "vars": {
    "PUBLIC_SITE_ORIGIN": "https://arthscan.me",
    // Must match the API Worker: pages need sign-in, crawlers are told to stay out.
    "INVITE_ONLY": "true"
  },
  // Secret (wrangler secret put): INTERNAL_API_KEY — must match the API Worker's.
  "observability": { "enabled": true }
}
