# Local SQLite database file (D1-compatible schema). Cloudflare D1 replaces this later.
DATABASE_PATH=./data/arthlens.db

# API server
API_PORT=8787
PUBLIC_SITE_ORIGIN=http://localhost:5173
# Secret mixed into API-token hashes. Change for any shared deployment.
TOKEN_PEPPER=change-me-local-pepper
# Lets the website's server talk to the API without spending a user's quota.
INTERNAL_API_KEY=change-me-internal-key
# Free plan: tool calls per account per day (MCP + REST combined).
FREE_DAILY_QUOTA=50

# Local dev sign-in (no Google needed). Turn OFF anywhere public.
AUTH_DEV_LOGIN=true
# Required whenever the site is reachable from outside (npm run tunnel sets one if empty).
AUTH_DEV_LOGIN_CODE=

# Google sign-in. Dormant until all three are set.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
